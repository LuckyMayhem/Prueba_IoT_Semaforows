<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ver_perfil"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvusuperfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B263B"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Nombre Usuario"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:text="Ver Perfil"
        android:textColor="@android:color/black"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:orientation="vertical">

        <!-- Fila Rut -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Rut"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvrutper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Contenido"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Nombre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Nombre"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvnomper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Contenido"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Apellido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Apellido"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvapeper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Contenido"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Correo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Correo"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvemaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Contenido"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Ocupación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Ocupación"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvocuper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Contenido"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Contraseña -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Contraseña"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvconper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E6D854"
                android:text="Contenido"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnvolper"
        android:layout_width="320dp"
        android:layout_height="55dp"
        android:backgroundTint="#8B0000"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Volver"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>