<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_estadisticas"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvusuestadisticas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B263B"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:text="Nombre Usuario"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        android:background="#160D0D"
        android:text="Estadísticas"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <!-- Fila Activaciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:background="#34E951"
                android:text="Tiempo Activo"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#34E951"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActivaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#34E951"
                android:text="50 Segundos"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Desactivaciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:background="#E44D4D"
                android:text="Tiempo inactivo"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#E44D4D"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDesactivaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E44D4D"
                android:text="10 Segundos"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Obstáculos Detectados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:background="#548BDC"
                android:text="Personas Detectadas"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="20sp"
                android:layout_height="44sp"
                android:background="#548BDC"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvObstaculos"
                android:layout_width="match_parent"
                android:layout_height="44sp"
                android:layout_gravity="center_vertical"
                android:background="#548BDC"
                android:gravity="center"
                android:text="23"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Fila Distancia Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:background="#F0D76F"
                android:text="Distancia Frecuente"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:background="#F0D76F"
                android:text=":"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDistanciaTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0D76F"
                android:text="9cm"
                android:textColor="@android:color/black"
                android:textSize="17sp" />
        </LinearLayout>


    </LinearLayout>

    <Button
        android:id="@+id/btnvolest"
        android:layout_width="320dp"
        android:layout_height="55dp"
        android:backgroundTint="#8B0000"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Volver"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>